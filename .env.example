# ---- shared ----
BRAND="Puja Path"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pujapath
# Background jobs: inline = run inside the API (no Redis, no worker process); worker = Arq + Redis
JOBS_MODE=inline
REDIS_URL=redis://localhost:6379/0
# Optional: lets an external scheduler call POST /v1/internal/cron (header X-Cron-Secret) on serverless hosts
CRON_SECRET=
# Admin sign-in: false = email + password only; true = also an authenticator-app code
STAFF_2FA=false
JWT_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=change-me
API_URL=http://localhost:8000
APP_ENV=development
# staging only: basic auth "user:pass" and noindex
STAGING_BASIC_AUTH=

# ---- media ----
# Only for apps/api/scripts/fetch_images.py (demo photos from Pexels)
PEXELS_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# folder inside the bucket, e.g. pujapath/ when the bucket is shared with another app
R2_KEY_PREFIX=
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=

# ---- providers ----
MESSAGING_PROVIDER=fake
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_WEBHOOK_TOKEN=
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_WEBHOOK_TOKEN=
# Only send these message types (comma list); empty = all 18
MESSAGING_TEMPLATES=
# Templates are named {prefix}_{key}_{locale}, e.g. pp_booking_confirmed_en
MESSAGING_TEMPLATE_PREFIX=pp
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
SHIPPING_PROVIDER=fake
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_TOKEN=
# SMS login codes: fake | msg91 | telnyx. Telnyx: API key, sender number (E.164), optional messaging profile
SMS_OTP_PROVIDER=fake
SMS_OTP_API_KEY=
SMS_OTP_FROM=
SMS_OTP_MESSAGING_PROFILE_ID=

# ---- ops alerts ----
OPS_ALERT_EMAIL=
SMTP_URL=
SLACK_WEBHOOK_URL=

# ---- observability ----
SENTRY_DSN=
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- bootstrap admin (seed) ----
ADMIN_EMAIL=admin@pujapath.local
ADMIN_PASSWORD=change-me-now
